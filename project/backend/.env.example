# Anti-DDoS Backend Configuration
# Copy this file to .env and adjust paths as needed

# Path to rules persistence file
ANTIDDOS_RULES_FILE=/var/lib/antiddos/rules.json

# Unix socket for DPDK datapath communication
ANTIDDOS_SOCKET_PATH=/var/run/antiddos/control.sock

# Layer 1 configuration file
ANTIDDOS_LAYER1_CONFIG=/etc/antiddos/layer1_config.json

# Layer 2 configuration file
ANTIDDOS_LAYER2_CONFIG=/etc/antiddos/layer2_config.json

# MaxMind GeoIP database path
ANTIDDOS_GEOIP_DB=/var/lib/antiddos/geoip/GeoLite2-Country.mmdb

# API authentication token (optional - will be auto-generated if not set)
# ANTIDDOS_API_TOKEN=your-secure-token-here

# Dashboard admin login (required for the login page and /api/v2/auth/login).
# There is no default password: set a strong one (12+ characters) before first login,
# or set ANTIDDOS_ADMIN_PASS_HASH to a bcrypt hash instead. start.sh writes a random
# password here when it creates backend/.env from this file.
ANTIDDOS_ADMIN_USER=admin
ANTIDDOS_ADMIN_PASS=
