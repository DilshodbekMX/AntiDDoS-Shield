# Unit Tests Build Configuration
#
# Build with: meson compile -C builddir
# Run with:   meson test -C builddir
#
# Note: Tests can run without hugepages using --no-huge flag

if get_option('build_tests')
    # Test: Conformal combiner (pure C, no DPDK) — calibrated false-alarm control
    test_conformal_combine = executable(
        'test_conformal_combine',
        files('test_conformal_combine.c', '../../layer2/conformal_combine.c'),
        include_directories: [include_directories('../../')],
        link_args: ['-lm'],
        install: false,
    )
    test('conformal_combine_tests', test_conformal_combine)

    # Test: Routed-FDR math (pure C, no DPDK) — §5.8 routed conformal + ACAT +
    # BH-FDR. Bit-level fidelity vs experiment/routed_fdr/routed_detector.py.
    # Reference vectors generated by _gen_routed_fdr_vectors.py into
    # routed_fdr_vectors.h (regenerate after editing the Python reference).
    test_routed_fdr = executable(
        'test_routed_fdr',
        files('test_routed_fdr.c',
              '../../layer2/routed_fdr.c',
              '../../layer2/conformal_combine.c'),
        include_directories: [include_directories('../../')],
        link_args: ['-lm'],
        install: false,
    )
    test('routed_fdr_tests', test_routed_fdr)

    # Test: Conformal live-wiring (pure C, no DPDK) — warm-up guard + benign calibration
    # + decision (paper §4.10). Verifies the buffer auto-sizes to >=3/alpha.
    test_conformal_live = executable(
        'test_conformal_live',
        files('test_conformal_live.c',
              '../../layer2/conformal_live.c',
              '../../layer2/conformal_combine.c'),
        include_directories: [include_directories('../../')],
        link_args: ['-lm'],
        install: false,
    )
    test('conformal_live_tests', test_conformal_live)

    # Test: Routed-FDR live-wiring (pure C, no DPDK) — per-feature channels + BH-FDR (§6.15).
    test_routed_live = executable(
        'test_routed_live',
        files('test_routed_live.c',
              '../../layer2/routed_live.c',
              '../../layer2/routed_fdr.c',
              '../../layer2/conformal_combine.c'),
        include_directories: [include_directories('../../')],
        link_args: ['-lm'],
        install: false,
    )
    test('routed_live_tests', test_routed_live)

    # Test: Layer-2 config round-trip (pure C, no DPDK) -- parse<->serialize symmetry for
    # ensemble_rule + conformal params (round-trip regression) + default-OR + range-check.
    test_layer2_config = executable(
        'test_layer2_config',
        files('test_layer2_config.c',
              '../../layer2/config/layer2_config.c',
              '../../external/cJSON.c'),
        include_directories: [include_directories('../../', '../../external')],
        link_args: ['-lm'],
        install: false,
    )
    test('layer2_config_tests', test_layer2_config)

    # Test: Innovation-gated z-path latch (pure C, no DPDK). Steady high-z is
    # unsurprising -> latch closes (z-path gated); a sharp z jump is surprising -> latch opens.
    test_innovation_gate = executable(
        'test_innovation_gate',
        files('test_innovation_gate.c',
              '../../layer2/innovation_gate.c'),
        include_directories: [include_directories('../../')],
        link_args: ['-lm'],
        install: false,
    )
    test('innovation_gate_tests', test_innovation_gate)

    # Test: common/simd_utils.h (pure C, no DPDK). Nothing else includes the header, so
    # this is its only build: the helpers against scalar references, and a compile-time
    # guard against the removed second HyperLogLog path (simd_hll_batch_add and
    # simd_hll_harmonic_sum; every HLL user goes through hll_add / hll_count).
    test_simd_utils = executable(
        'test_simd_utils',
        files('test_simd_utils.c'),
        include_directories: [include_directories('../../')],
        install: false,
    )
    test('simd_utils_tests', test_simd_utils)

    # Test: burst_factor EWMA (pure C, no DPDK) -- the one definition shared by the
    # aggregate path (shared_memory.c) and the per-IP path (per_ip_features*.c): seed,
    # steady state 100, 4x burst -> 363, saturation at 100/alpha, bit-identity with the
    # legacy aggregate literal code.
    test_burst_ewma = executable(
        'test_burst_ewma',
        files('test_burst_ewma.c'),
        include_directories: [include_directories('../../')],
        link_args: ['-lm'],
        install: false,
    )
    test('burst_ewma_tests', test_burst_ewma)
    # Test: Subspace-Q + EWMA Parity Fixture (pure C, no DPDK) -- bit-level C engine fidelity



  # --- DPDK-dependent unit tests (need liblayer1/liblayer2) ---
  if dpdk_dep.found()
    test_env = environment()
    test_env.set('XDG_RUNTIME_DIR', '/tmp')

    # Test: Packet Parser (requires DPDK EAL)
    test_packet_parser = executable(
        'test_packet_parser',
        files('test_packet_parser.c'),
        dependencies: [dpdk_dep, m_dep],
        link_with: [layer1_lib],
        include_directories: [include_directories('../../')],
        install: false,
    )
    test('packet_parser_tests', test_packet_parser, env: test_env)

    # Test: Stage 6c attack signatures (requires DPDK EAL, up to four lcores): a
    # SYN-only frame of 60 bytes or less (no options, or MSS only, as lwIP sends)
    # passes on its own, a source that scans (many ports or many such SYNs per
    # window) is dropped, strict_syn_scan keeps the earlier rule, and the other
    # signatures are unchanged. Reads the shipped layer1_config.json.
    test_signatures = executable(
        'test_signatures',
        files('test_signatures.c'),
        c_args: ['-DSIG_SHIPPED_CONFIG="' + join_paths(meson.current_source_dir(),
                 '..', '..', 'layer1', 'config', 'layer1_config.json') + '"'],
        dependencies: [dpdk_dep, m_dep],
        link_with: [layer1_lib, libcjson],
        include_directories: [include_directories('../../')],
        install: false,
    )
    test('signatures_tests', test_signatures, env: test_env)

    # Test: Layer 2 Detection (Z-score thresholds, baseline poisoning)
    test_detection = executable(
        'test_detection',
        files('test_detection.c'),
        dependencies: [dpdk_dep, m_dep],
        link_with: [liblayer2, liblayer1, libcjson],
        include_directories: [include_directories('../../')],
        link_args: ['-lm', '-lpthread'],
        install: false,
    )
    test('detection_tests', test_detection, env: test_env)

    # Test: Layer 1 Config (emergency drop, progressive rate limiting)
    test_layer1_config = executable(
        'test_layer1_config',
        files('test_layer1_config.c'),
        dependencies: [dpdk_dep, m_dep],
        link_with: [liblayer1, libcjson],
        include_directories: [include_directories('../../')],
        install: false,
    )
    test('layer1_config_tests', test_layer1_config, env: test_env)

    # Test: SYN Proxy (cookie generation, validation, state machine)
    test_syn_proxy = executable(
        'test_syn_proxy',
        files('test_syn_proxy.c'),
        dependencies: [dpdk_dep, m_dep],
        link_with: [layer1_lib],
        include_directories: [include_directories('../../')],
        install: false,
    )
    test('syn_proxy_tests', test_syn_proxy, env: test_env)

    # Test: IP lists (the whitelist's writers from several threads at once, and the
    # legitimate-source table: bounded, expiring, never the whitelist, written from every
    # packet lcore without a lock)
    test_ip_lists = executable(
        'test_ip_lists',
        files('test_ip_lists.c'),
        dependencies: [dpdk_dep, m_dep],
        link_with: [layer1_lib],
        include_directories: [include_directories('../../')],
        link_args: ['-lpthread'],
        install: false,
    )
    test('ip_lists_tests', test_ip_lists, env: test_env)

    # Test: Flow Table (lookup, create, rate limiting, aging)
    test_flow_table = executable(
        'test_flow_table',
        files('test_flow_table.c'),
        dependencies: [dpdk_dep, m_dep],
        link_with: [layer1_lib],
        include_directories: [include_directories('../../')],
        install: false,
    )
    test('flow_table_tests', test_flow_table, env: test_env)

    # Test: Protected Subnets (CIDR aggregation, exact-/32 precedence, masking)
    test_protected_subnet = executable(
        'test_protected_subnet',
        files('test_protected_subnet.c'),
        dependencies: [dpdk_dep, m_dep],
        link_with: [layer1_lib],
        include_directories: [include_directories('../../')],
        install: false,
    )
    test('protected_subnet_tests', test_protected_subnet, env: test_env)

    # Test: IPv6 Pipeline (ip_lists_v6, syn_proxy_v6, geo_blocking_v6, flow_table_v6)
    test_ipv6_pipeline = executable(
        'test_ipv6_pipeline',
        files('test_ipv6_pipeline.c'),
        dependencies: [dpdk_dep, m_dep],
        link_with: [layer1_lib],
        include_directories: [include_directories('../../')],
        install: false,
    )
    test('ipv6_pipeline_tests', test_ipv6_pipeline, env: test_env)

    # Test: Baselines (EWMA, z-score, three-tier, poisoning)
    test_baselines = executable(
        'test_baselines',
        files('test_baselines.c'),
        dependencies: [dpdk_dep, m_dep],
        link_with: [liblayer2, libcjson],
        include_directories: [include_directories('../../')],
        link_args: ['-lm', '-lpthread'],
        install: false,
    )
    test('baselines_tests', test_baselines, env: test_env)

    # Test: Per-IP burst_factor wiring (Phase 2) -- snapshot previews, reset_window commits,
    # v4 + v6 (requires EAL: rte_hash / rte_malloc; exits 77 = skip if EAL cannot init)
    test_per_ip_burst = executable(
        'test_per_ip_burst',
        files('test_per_ip_burst.c'),
        dependencies: [dpdk_dep, m_dep],
        link_with: [layer1_lib],
        include_directories: [include_directories('../../')],
        install: false,
    )
    test('per_ip_burst_tests', test_per_ip_burst, env: test_env)

    # Test: HyperLogLog accuracy through the engine's key paths (per-IP v4 and v6 slots,
    # protected-subnet slot, global source-IP HLL), random and sequential keys, 1 to 10^6
    # distinct keys (requires EAL: rte_hash / rte_malloc / rte_lpm; exits 77 = skip if EAL
    # cannot init)
    test_hll_accuracy = executable(
        'test_hll_accuracy',
        files('test_hll_accuracy.c'),
        dependencies: [dpdk_dep, m_dep],
        link_with: [layer1_lib],
        include_directories: [include_directories('../../')],
        install: false,
    )
    test('hll_accuracy_tests', test_hll_accuracy, env: test_env)

    # Test: new flows to addresses covered only by a protected subnet count on the subnet's
    # per-IP slot, through layer1_init() + layer1_process_packet_ex(). Runs in a private user +
    # mount namespace with its own /dev/shm and a temporary directory; exits 77 = skip when
    # that isolation (or EAL) is unavailable
    test_subnet_new_flows = executable(
        'test_subnet_new_flows',
        files('test_subnet_new_flows.c'),
        dependencies: [dpdk_dep, sqlite3_dep, m_dep],
        link_with: [core_lib, liblayer2, liblayer1, libcjson],
        include_directories: [include_directories('../../')],
        link_args: ['-lpthread'],
        install: false,
    )
    test('subnet_new_flows_tests', test_subnet_new_flows, env: test_env)

    # Test: the same pipeline check without any namespace, so Stage 11's call site stays
    # covered where unprivileged namespaces are unavailable. It compiles layer1.c into the
    # test with the three layer1_init() calls that create /dev/shm files renamed (private
    # DPDK-heap shared memory; the realtime and window segments report failure), and
    # confines its writes with Landlock where available. See the file header.
    test_subnet_new_flows_seam = executable(
        'test_subnet_new_flows_seam',
        files('test_subnet_new_flows.c'),
        c_args: ['-DSUBNET_FLOWS_SEAM'],
        dependencies: [dpdk_dep, sqlite3_dep, m_dep],
        link_with: [core_lib, liblayer2, liblayer1, libcjson],
        include_directories: [include_directories('../../', '../../common', '../../external',
            '../../layer1', '../../layer1/config', '../../layer1/interlayer',
            '../../layer1/datapath', '../../layer1/tables', '../../layer1/telemetry',
            '../../layer2', '../../layer2/config', '../../core')],
        link_args: ['-lpthread'],
        install: false,
    )
    test('subnet_new_flows_seam_tests', test_subnet_new_flows_seam, env: test_env)

    # Test: flow tracking through layer1_process_packet_ex(): RST/FIN validation at IPv4 and
    # IPv6 Stage 11, the IPv6 Stage 11 counters, and the flows of SYN proxy connections
    # (Stage 9 and the outbound path). Compiles layer1.c in with the /dev/shm init calls
    # renamed, as subnet_new_flows_seam_tests does (see the file header).
    test_flow_pipeline = executable(
        'test_flow_pipeline',
        files('test_flow_pipeline.c'),
        dependencies: [dpdk_dep, sqlite3_dep, m_dep],
        link_with: [core_lib, liblayer2, liblayer1, libcjson],
        include_directories: [include_directories('../../', '../../common', '../../external',
            '../../layer1', '../../layer1/config', '../../layer1/interlayer',
            '../../layer1/datapath', '../../layer1/tables', '../../layer1/telemetry',
            '../../layer2', '../../layer2/config', '../../core')],
        link_args: ['-lpthread'],
        install: false,
    )
    test('flow_pipeline_tests', test_flow_pipeline, env: test_env)

    # Tables written from several lcores (shared harness: shared_table_test.h; EAL on up
    # to four lcores, exits 77 = skip if EAL cannot init)

    # Test: TCP flag rate table (Stage 9b): deleted sources' positions come back after
    # the readers' grace period, a full table accepts new sources untracked, writers hold
    # the writer lock (seams), concurrent adds and churn on several lcores (stress)
    test_tcp_flag_rate = executable(
        'test_tcp_flag_rate',
        files('test_tcp_flag_rate.c'),
        dependencies: [dpdk_dep, m_dep],
        link_with: [layer1_lib],
        include_directories: [include_directories('../../')],
        install: false,
    )
    test('tcp_flag_rate_tests', test_tcp_flag_rate, env: test_env)

    # Test: per-IP feature unregistration: register/unregister cycles beyond the hash
    # size, an unregistered slot and its count-min counters released only after the
    # readers' grace period, bounded wait for a slot, control-path walks under the
    # control lock (seams), concurrent churn with walks and packet updates (stress)
    test_per_ip_unregister = executable(
        'test_per_ip_unregister',
        files('test_per_ip_unregister.c'),
        dependencies: [dpdk_dep, m_dep],
        link_with: [layer1_lib],
        include_directories: [include_directories('../../')],
        install: false,
    )
    test('per_ip_unregister_tests', test_per_ip_unregister, env: test_env)

    # Test: connection limits table (Stage 10 without the SYN proxy): concurrent first
    # connections on several lcores all tracked (stress), a racing add counted on the
    # winner's tracker, writers hold the writer lock (seams), a deleted tracker reused
    # only after the readers' grace period, the cleanup's clock comparison
    test_connection_limits = executable(
        'test_connection_limits',
        files('test_connection_limits.c'),
        dependencies: [dpdk_dep, m_dep],
        link_with: [layer1_lib],
        include_directories: [include_directories('../../', '../../common')],
        install: false,
    )
    test('connection_limits_tests', test_connection_limits, env: test_env)

    # Test: per-source-IP statistics (not initialised by the shipped engine): entries
    # for every hash position, updates and expiry from a non-EAL thread, a deleted
    # entry kept for the readers' grace period, writer and control locks (seams),
    # concurrent first packets on several lcores (stress)
    test_src_ip_stats = executable(
        'test_src_ip_stats',
        files('test_src_ip_stats.c'),
        dependencies: [dpdk_dep, m_dep],
        link_with: [layer1_lib],
        include_directories: [include_directories('../../')],
        link_args: ['-lpthread'],
        install: false,
    )
    test('src_ip_stats_tests', test_src_ip_stats, env: test_env)

    # Test: fast-path spike detector (not initialised by the shipped engine): lookups
    # through the registered slot, foreign lcore ids refused, windows kept for the
    # readers' grace period, control lock (seams), concurrent churn (stress)
    test_spike_detector = executable(
        'test_spike_detector',
        files('test_spike_detector.c'),
        dependencies: [dpdk_dep, m_dep],
        link_with: [layer1_lib],
        include_directories: [include_directories('../../')],
        install: false,
    )
    test('spike_detector_tests', test_spike_detector, env: test_env)
  endif  # dpdk_dep.found()
endif
