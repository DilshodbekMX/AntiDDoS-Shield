# Unit Tests Build Configuration
#
# Build with: meson compile -C builddir
# Run with:   meson test -C builddir
#
# Note: Tests can run without hugepages using --no-huge flag

if get_option('build_tests')
    # Test: Conformal combiner (pure C, no DPDK) — calibrated false-alarm control
    test_conformal_combine = executable(
        'test_conformal_combine',
        files('test_conformal_combine.c', '../../layer2/conformal_combine.c'),
        include_directories: [include_directories('../../')],
        link_args: ['-lm'],
        install: false,
    )
    test('conformal_combine_tests', test_conformal_combine)

    # Test: Routed-FDR math (pure C, no DPDK) — §5.8 routed conformal + ACAT +
    # BH-FDR. Bit-level fidelity vs experiment/routed_fdr/routed_detector.py.
    # Reference vectors generated by _gen_routed_fdr_vectors.py into
    # routed_fdr_vectors.h (regenerate after editing the Python reference).
    test_routed_fdr = executable(
        'test_routed_fdr',
        files('test_routed_fdr.c',
              '../../layer2/routed_fdr.c',
              '../../layer2/conformal_combine.c'),
        include_directories: [include_directories('../../')],
        link_args: ['-lm'],
        install: false,
    )
    test('routed_fdr_tests', test_routed_fdr)

    # Test: Conformal live-wiring (pure C, no DPDK) — warm-up guard + benign calibration
    # + decision (paper §4.10). Verifies the buffer auto-sizes to >=3/alpha.
    test_conformal_live = executable(
        'test_conformal_live',
        files('test_conformal_live.c',
              '../../layer2/conformal_live.c',
              '../../layer2/conformal_combine.c'),
        include_directories: [include_directories('../../')],
        link_args: ['-lm'],
        install: false,
    )
    test('conformal_live_tests', test_conformal_live)

    # Test: Routed-FDR live-wiring (pure C, no DPDK) — per-feature channels + BH-FDR (§6.15).
    test_routed_live = executable(
        'test_routed_live',
        files('test_routed_live.c',
              '../../layer2/routed_live.c',
              '../../layer2/routed_fdr.c',
              '../../layer2/conformal_combine.c'),
        include_directories: [include_directories('../../')],
        link_args: ['-lm'],
        install: false,
    )
    test('routed_live_tests', test_routed_live)

    # Test: Layer-2 config round-trip (pure C, no DPDK) -- parse<->serialize symmetry for
    # ensemble_rule + conformal params (round-trip regression) + default-OR + range-check.
    test_layer2_config = executable(
        'test_layer2_config',
        files('test_layer2_config.c',
              '../../layer2/config/layer2_config.c',
              '../../external/cJSON.c'),
        include_directories: [include_directories('../../', '../../external')],
        link_args: ['-lm'],
        install: false,
    )
    test('layer2_config_tests', test_layer2_config)

    # Test: Innovation-gated z-path latch (pure C, no DPDK). Steady high-z is
    # unsurprising -> latch closes (z-path gated); a sharp z jump is surprising -> latch opens.
    test_innovation_gate = executable(
        'test_innovation_gate',
        files('test_innovation_gate.c',
              '../../layer2/innovation_gate.c'),
        include_directories: [include_directories('../../')],
        link_args: ['-lm'],
        install: false,
    )
    # Test: Subspace-Q + EWMA Parity Fixture (pure C, no DPDK) -- bit-level C engine fidelity



  # --- DPDK-dependent unit tests (need liblayer1/liblayer2) ---
  if dpdk_dep.found()
    test_env = environment()
    test_env.set('XDG_RUNTIME_DIR', '/tmp')

    # Test: Packet Parser (requires DPDK EAL)
    test_packet_parser = executable(
        'test_packet_parser',
        files('test_packet_parser.c'),
        dependencies: [dpdk_dep, m_dep],
        link_with: [layer1_lib],
        include_directories: [include_directories('../../')],
        install: false,
    )
    test('packet_parser_tests', test_packet_parser, env: test_env)

    # Test: Layer 2 Detection (Z-score thresholds, baseline poisoning)
    test_detection = executable(
        'test_detection',
        files('test_detection.c'),
        dependencies: [dpdk_dep, m_dep],
        link_with: [liblayer2, liblayer1, libcjson],
        include_directories: [include_directories('../../')],
        link_args: ['-lm', '-lpthread'],
        install: false,
    )
    test('detection_tests', test_detection, env: test_env)

    # Test: Layer 1 Config (emergency drop, progressive rate limiting)
    test_layer1_config = executable(
        'test_layer1_config',
        files('test_layer1_config.c'),
        dependencies: [dpdk_dep, m_dep],
        link_with: [liblayer1, libcjson],
        include_directories: [include_directories('../../')],
        install: false,
    )
    test('layer1_config_tests', test_layer1_config, env: test_env)

    # Test: SYN Proxy (cookie generation, validation, state machine)
    test_syn_proxy = executable(
        'test_syn_proxy',
        files('test_syn_proxy.c'),
        dependencies: [dpdk_dep, m_dep],
        link_with: [layer1_lib],
        include_directories: [include_directories('../../')],
        install: false,
    )
    test('syn_proxy_tests', test_syn_proxy, env: test_env)

    # Test: Flow Table (lookup, create, rate limiting, aging)
    test_flow_table = executable(
        'test_flow_table',
        files('test_flow_table.c'),
        dependencies: [dpdk_dep, m_dep],
        link_with: [layer1_lib],
        include_directories: [include_directories('../../')],
        install: false,
    )
    test('flow_table_tests', test_flow_table, env: test_env)

    # Test: Protected Subnets (CIDR aggregation, exact-/32 precedence, masking)
    test_protected_subnet = executable(
        'test_protected_subnet',
        files('test_protected_subnet.c'),
        dependencies: [dpdk_dep, m_dep],
        link_with: [layer1_lib],
        include_directories: [include_directories('../../')],
        install: false,
    )
    test('protected_subnet_tests', test_protected_subnet, env: test_env)

    # Test: IPv6 Pipeline (ip_lists_v6, syn_proxy_v6, geo_blocking_v6, flow_table_v6)
    test_ipv6_pipeline = executable(
        'test_ipv6_pipeline',
        files('test_ipv6_pipeline.c'),
        dependencies: [dpdk_dep, m_dep],
        link_with: [layer1_lib],
        include_directories: [include_directories('../../')],
        install: false,
    )
    test('ipv6_pipeline_tests', test_ipv6_pipeline, env: test_env)

    # Test: Baselines (EWMA, z-score, three-tier, poisoning)
    test_baselines = executable(
        'test_baselines',
        files('test_baselines.c'),
        dependencies: [dpdk_dep, m_dep],
        link_with: [liblayer2, libcjson],
        include_directories: [include_directories('../../')],
        link_args: ['-lm', '-lpthread'],
        install: false,
    )
    test('baselines_tests', test_baselines, env: test_env)
  endif  # dpdk_dep.found()
endif
